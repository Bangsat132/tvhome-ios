<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The theme is deliberately opaque: on some firmware Theme.DeviceDefault comes out translucent, the TV
         app keeps running under Home, and after an HDMI input the picture stays on screen. -->
    <style name="Theme.TvHome" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSwipeToDismiss">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
